{
    "name": "ts-seed",
    "version": "0.0.0",
    "description": "TS Seed Project",
    "license": "MIT",
    "author": "Kristof Mattei",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "debug": "vite-node src/index.ts",
        "debug:watch": "vite-node --watch src/index.ts",
        "build": "vite build",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "format": "oxfmt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html src",
        "start": "node -r source-map-support/register ./dist/index.js"
    },
    "dependencies": {
        "@fastify/type-provider-typebox": "6.1.0",
        "env-schema": "8.0.0",
        "fastify": "5.12.1",
        "pino-pretty": "13.1.3",
        "source-map-support": "0.5.21"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "26.3.0",
        "@types/semver": "7.8.0",
        "@types/source-map-support": "0.5.10",
        "@vitest/coverage-v8": "4.1.11",
        "@vitest/ui": "4.1.11",
        "dependency-cruiser": "18.2.0",
        "eslint-plugin-n": "18.3.0",
        "eslint-plugin-perfectionist": "5.10.1",
        "husky": "9.1.7",
        "lint-staged": "17.3.0",
        "oxfmt": "0.64.0",
        "oxlint": "1.79.0",
        "oxlint-tsgolint": "7.0.2001",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-node": "6.0.0",
        "vite-plugin-checker": "0.14.5",
        "vitest": "4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.7.0",
        "pnpm": "11.23.0"
    },
    "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
