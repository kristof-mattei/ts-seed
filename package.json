{
    "name": "ts-seed",
    "version": "0.0.0",
    "description": "TS Seed Project",
    "license": "MIT",
    "author": "Kristof Mattei",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "debug": "vite-node src/index.ts",
        "debug:watch": "vite-node --watch src/index.ts",
        "build": "vite build",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "format": "oxfmt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html src",
        "start": "node -r source-map-support/register ./dist/index.js"
    },
    "dependencies": {
        "@fastify/type-provider-typebox": "6.3.0",
        "env-schema": "8.0.1",
        "fastify": "5.12.7",
        "pino-pretty": "13.2.0",
        "source-map-support": "0.5.21"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "26.6.6",
        "@types/semver": "7.8.0",
        "@types/source-map-support": "0.5.10",
        "@vitest/coverage-v8": "5.0.5",
        "@vitest/ui": "5.0.5",
        "dependency-cruiser": "18.7.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-perfectionist": "5.13.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.0",
        "oxfmt": "0.75.0",
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-node": "6.0.0",
        "vite-plugin-checker": "0.14.5",
        "vitest": "5.0.5"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.13.0"
    },
    "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
