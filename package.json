{
    "name": "ts-seed",
    "version": "0.0.0",
    "description": "TS Seed Project",
    "license": "MIT",
    "author": "Kristof Mattei",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "debug": "vite-node src/index.ts",
        "debug:watch": "vite-node --watch src/index.ts",
        "build": "vite build",
        "test": "vitest --coverage.enabled=true",
        "lint": "oxlint",
        "lint:fix": "pnpm run lint --fix",
        "prepare": "husky",
        "format": "oxfmt",
        "spellcheck": "cspell --no-progress \"**\"",
        "spellcheck:update": ": > project-words.txt && cspell --no-progress --words-only --unique \"**\" | tr '[:upper:]' '[:lower:]' | LC_ALL=en_US.UTF8 sort --unique > project-words.txt",
        "deps:ci": "depcruise --config dependency-cruiser.config.ts --output-type err src",
        "deps:graph": "depcruise --config dependency-cruiser.config.ts --output-type dot src | dot -T svg > reports/dependency-graph.svg",
        "deps:report": "depcruise --config dependency-cruiser.config.ts --output-type err-html --output-to reports/dependency-report.html src",
        "start": "node -r source-map-support/register ./dist/index.js"
    },
    "dependencies": {
        "@fastify/type-provider-typebox": "6.3.0",
        "env-schema": "8.0.2",
        "fastify": "5.12.8",
        "pino-pretty": "13.2.0",
        "source-map-support": "0.5.21"
    },
    "devDependencies": {
        "@codecov/vite-plugin": "2.0.1",
        "@types/node": "26.6.10",
        "@types/semver": "7.8.0",
        "@types/source-map-support": "0.5.10",
        "@vitest/coverage-v8": "5.1.2",
        "@vitest/ui": "5.1.2",
        "cspell": "10.5.2",
        "dependency-cruiser": "18.9.0",
        "eslint-plugin-n": "18.5.0",
        "eslint-plugin-perfectionist": "5.14.0",
        "husky": "9.1.7",
        "lint-staged": "17.6.2",
        "oxfmt": "0.80.0",
        "oxlint": "1.95.0",
        "oxlint-tsgolint": "7.0.2008",
        "typescript": "6.0.3",
        "vite": "catalog:default",
        "vite-node": "6.0.0",
        "vite-plugin-checker": "1.0.0",
        "vitest": "5.1.2"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "oxlint --no-error-on-unmatched-pattern --",
            "depcruise --config dependency-cruiser.config.ts --include-only ^src/ --validate --"
        ],
        "*": [
            "oxfmt --check --no-error-on-unmatched-pattern --"
        ]
    },
    "engines": {
        "node": "26.13.1"
    },
    "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975"
}
